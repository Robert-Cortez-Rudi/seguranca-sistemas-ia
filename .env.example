# Copie para .env e preencha. Nunca versione o .env (A02).
# Gere os segredos com: node scripts/gen-secrets.mjs

# Postgres do docker-compose
POSTGRES_USER=
POSTGRES_PASSWORD=
# Porta do Postgres na sua máquina. Se trocar, gere o .env de novo (as URLs abaixo usam esta porta).
POSTGRES_PORT=5434
DATABASE_URL=
# Banco usado pelo Vitest (mesmo servidor, base secureshop_test)
DATABASE_URL_TEST=

# Endereço exato que você digita no navegador. Usado nos links de e-mail, na checagem de
# Origin das rotas de API e pelo gateway de pagamento simulado. Se mudar PORT, mude aqui também.
APP_URL=http://localhost:3000

# Servidor da aplicação (server.mjs)
PORT=3000
HOST=localhost
# Quantos proxies reversos confiáveis ficam na frente da aplicação (0 = acesso direto)
TRUST_PROXY_HOPS=0

# Chave AES-256-GCM: 32 bytes em base64
ENCRYPTION_KEY=
# Chave HMAC-SHA256 do blind index (CPF): 32 bytes em base64, diferente da anterior
BLIND_INDEX_KEY=
# Segredo HMAC do webhook de pagamento simulado
PAYMENT_WEBHOOK_SECRET=

# Mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=SecureShop <no-reply@secureshop.local>
